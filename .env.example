# ==============================================================================
# SMILE DENTAL AND IMPLANT CENTRE - VOICE & WHATSAPP CRM ENVIRONMENT
# ==============================================================================

# Server & Runtime
PORT=8000
ENVIRONMENT=production
PYTHONUNBUFFERED=1

# Brand & Clinic Settings
BUSINESS_NAME=Smile Dental and Implant Centre
BUSINESS_TYPE=Dental Clinic & Implant Centre
DEFAULT_SERVICE_TYPE=Dental Consultation
BUSINESS_CITY=Secunderabad / Hyderabad
APP_TIMEZONE=Asia/Kolkata
APP_COUNTRY=India
APP_COUNTRY_CODE=+91

# Database Backend (mysql for Coolify deployment)
CRM_DB_BACKEND=mysql
AIRZEN_DB_BACKEND=mysql

# MySQL Database (Coolify internal or external connection)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smiledental_crm
MYSQL_USER=crm_user
MYSQL_PASSWORD=

# Supabase (Fallback/Alternative if Supabase is selected)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Authentication Credentials for Demo & Staff
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SmileDental@2026
ADMIN_API_KEY=smiledental-secret-key-2026

# WhatsApp Business Cloud API (Add when clinic registers Meta WhatsApp Cloud number)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=smiledental_wh_token_2026
WHATSAPP_DEFAULT_LANGUAGE=en

# WhatsApp Smart Follow-Up & Appointment Flow
FOLLOWUP_ENABLED=true
FOLLOWUP_TIMEZONE=Asia/Kolkata
FOLLOWUP_NO_RESPONSE_TEMPLATE_DELAY_HOURS=24
FOLLOWUP_MAX_WHATSAPP_FOLLOWUPS=3

# Voice Calling (LiveKit & SIP Outbound - Enable when clinic configures SIP trunk)
OUTBOUND_CALLING_ENABLED=false
ENABLE_VOICE_AGENT=false
VOICE_AGENT_NAME="Smile Dental Assistant"
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OUTBOUND_TRUNK_ID=
CALLER_ID=+917396529265

# AI & LLM Engine (Google Gemini 3.1 Flash / 2.5 Flash for chat & calling)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Kore
USE_GEMINI_REALTIME=true
DEEPGRAM_API_KEY=
