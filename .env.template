# ==============================================================================
# WHITE-LABEL CLIENT CONFIGURATION TEMPLATE
# Copy this file to .env before deploying for a new client
# ==============================================================================

# --- 1. CLIENT BRAND IDENTITY ---
BUSINESS_NAME="Apex Dental Clinic"
BUSINESS_TYPE="Dental Clinic"
DEFAULT_SERVICE_TYPE="Dental Consultation"
BUSINESS_CITY="Bangalore"
BUSINESS_PHONE="+919876543210"
SUPPORT_EMAIL="support@apexdental.com"
ADMIN_DEFAULT_PASSWORD="ClientSecurePassword2026!"

# --- 2. TELEPHONY & LIVEKIT (SIP / WebRTC) ---
LIVEKIT_URL="wss://livekit.yourdomain.com"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
OUTBOUND_TRUNK_ID="client_outbound_trunk_id"
CALLER_ID="+919876543210"

# --- 3. AI MODELS (VOICE / STT / TTS / LLM) ---
OPENAI_API_KEY="sk-proj-xxxx"
DEEPGRAM_API_KEY="dg_live_xxxx"
CARTESIA_API_KEY="cartesia_xxxx"

# --- 4. PERSISTENCE & DATABASE ---
# Provide an isolated MySQL, PostgreSQL, or Supabase database URL for this client
DATABASE_URL="mysql+pymysql://dbuser:dbpass@mysql-host:3306/client_database"

# --- 5. WHATSAPP CLOUD API / VOBIZ ---
WHATSAPP_PHONE_NUMBER_ID="client_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="client_meta_system_user_token"
WHATSAPP_BUSINESS_ACCOUNT_ID="client_meta_waba_id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="secure_random_verification_token"

# --- 6. SERVER PORT & HOSTING ---
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="production"
